              "const response = pm.response.json();\r\n\r\nif (pm.response.code === 200 && response.accessToken) {\r\n    const oldAccessToken = pm.collectionVariables.get('accessToken');\r\n\r\n    pm.collectionVariables.set('accessToken', response.accessToken);\r\n    pm.collectionVariables.set('refreshToken', response.refreshToken);\r\n\r\n    console.log('old accessToken:', oldAccessToken);\r\n    console.log('new accessToken:', pm.collectionVariables.get('accessToken'));\r\n} else {\r\n    console.error('Refresh failed:', pm.response.code, response.message);\r\n}"
